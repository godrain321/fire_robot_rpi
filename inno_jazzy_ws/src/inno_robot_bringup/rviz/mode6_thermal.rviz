Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 20
      Color: 100; 100; 100
      Alpha: 0.5
    - Class: rviz_default_plugins/Map
      Name: SLAM Map
      Enabled: true
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 5
      Color Scheme: map
      Alpha: 0.8
      Draw Behind: true
    - Class: rviz_default_plugins/Map
      Name: Static Planning Grid
      Enabled: false
      Topic:
        Value: /planning_grid_static
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 5
      Color Scheme: costmap
      Alpha: 0.20
      Draw Behind: true
    - Class: rviz_default_plugins/Map
      Name: Thermal Cost Grid
      Enabled: true
      Topic:
        Value: /thermal_cost_grid
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 5
      Color Scheme: costmap
      Alpha: 0.65
      Draw Behind: false
    - Class: rviz_default_plugins/LaserScan
      Name: RPLIDAR Scan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Decay Time: 0
      Position Transformer: XYZ
    - Class: rviz_default_plugins/PointCloud2
      Name: Thermal Arc Points
      Enabled: true
      Topic:
        Value: /thermal/arc_points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 4
      Color Transformer: Intensity
      Channel Name: intensity
      Decay Time: 0
      Position Transformer: XYZ
    - Class: rviz_default_plugins/Image
      Name: Thermal Image
      Enabled: true
      Topic:
        Value: /thermal/image
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/TF
      Name: TF Tree
      Enabled: true
      Frame Timeout: 15
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.3
    - Class: rviz_default_plugins/Odometry
      Name: RF2O Odometry
      Enabled: true
      Topic:
        Value: /odom_rf2o
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Shape:
        Value: Arrow
      Keep: 100
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
    - Class: rviz_default_plugins/Path
      Name: LiDAR Localized Path (Green)
      Enabled: true
      Topic:
        Value: /lidar_path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.05
  Enabled: true
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Angle: 0
      Scale: 20
      X: 0
      Y: 0
Window Geometry:
  Height: 900
  Width: 1400
